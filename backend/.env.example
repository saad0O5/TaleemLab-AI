# Port the backend HTTP server listens on
PORT=4000

# Google Gemini API key for the vision model (circuit recognition from images)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model name used for vision + text (must be a real, currently-served model)
# Common choices: gemini-3.6-flash (default), gemini-flash-latest
GEMINI_MODEL=gemini-3.6-flash
